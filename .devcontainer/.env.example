# Local development only. Copy to .devcontainer/.env and set a local-only password.
DB_NAME=devdb
DB_USER=devuser
DB_PASSWORD=replace-with-a-local-only-password
DB_HOST=db
DB_PORT=5432
DJANGO_ENV=dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-development-only-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
