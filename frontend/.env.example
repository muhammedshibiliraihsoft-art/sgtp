# Local development only. Must be the approved staging API origin.
# Do not prefix this with VITE_: it is consumed by the Vite dev server, not browser code.
AUTH_API_PROXY_TARGET=
# Keep legacy private-media uploads disabled for remote APIs with ephemeral disks.
# Enable only when deliberately using a local backend with filesystem storage.
VITE_ENABLE_LEGACY_PRIVATE_MEDIA_FALLBACK=false
