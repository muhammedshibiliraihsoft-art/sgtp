# Example environment variables for local development

# ── Environment Selector ──
# Controls which settings module is loaded (dev, test, staging, prod)
DJANGO_ENV=dev

# ── PostgreSQL ──
DB_NAME=devdb
DB_USER=devuser
DB_PASSWORD=devpasS@1234
DB_HOST=db
DB_PORT=5432

# ── Django ──
# IMPORTANT: Replace with a real >=50-char random secret in production.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key-at-least-50-chars-long
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PASSWORD_RESET_URL=http://localhost:3000/reset-password
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.test

# Production email delivery (configure in the deployment secret store)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Private Cloudflare R2 media (leave blank for local filesystem storage) ──
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ── CORS ──
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared staging only (never place staging secrets in this local example)
# DJANGO_ENV=staging
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api-staging.birky.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://staging.birky.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.birky.com
# PASSWORD_RESET_URL=https://staging.birky.com/reset-password
