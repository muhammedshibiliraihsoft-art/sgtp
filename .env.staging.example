# Local reference only. Do not use real credentials here or commit .env.staging.
DJANGO_ENV=staging
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=<set-only-in-Render-secret-storage>
DJANGO_ALLOWED_HOSTS=api-staging.birky.com
DJANGO_CORS_ALLOWED_ORIGINS=https://staging.birky.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.birky.com

# Use the internal connection string of the isolated staging-only database.
DATABASE_URL=<Render-internal-staging-PostgreSQL-connection-string>
DB_WAIT_TIMEOUT_SECONDS=60

PASSWORD_RESET_URL=https://staging.birky.com/reset-password
DJANGO_EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
DEFAULT_FROM_EMAIL=noreply@staging.birky.com

# Optional local runtime tuning; Render supplies PORT and WEB_CONCURRENCY.
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# One-time staging-only Main Supplier Admin creation; keep disabled by default.
# Configure these only in Render, enable for one controlled deploy, then blank
# the input values and disable the switch immediately after verification.
STAGING_MAIN_ADMIN_BOOTSTRAP_ENABLED=false
STAGING_MAIN_ADMIN_EMAIL=
STAGING_MAIN_ADMIN_FIRST_NAME=
STAGING_MAIN_ADMIN_PHONE=
STAGING_MAIN_ADMIN_PASSWORD=
